{
  "name": "assets-review-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Historical Assets team PR review workload dashboard (MetaMask Core, Mobile, Extension)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:test-fixtures": "bun tests/ui/build-fixtures.ts",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test:unit": "bun test tests/ui",
    "test:ui": "bun run build:test-fixtures && playwright test",
    "test": "bun run typecheck && bun run test:unit && bun run test:ui"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.65.0",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.0",
    "bun-types": "^1.4.2",
    "typescript": "^5.8.3",
    "vite": "^7.1.0",
    "yaml": "^2.9.1"
  }
}
